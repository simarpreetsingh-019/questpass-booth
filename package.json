{
  "name": "questpass-booth",
  "version": "1.0.0",
  "description": "A branded photo booth and video maker that runs on the phone: 23 frames, MP4 videos with music, a brand editor. Photos never leave the device.",
  "license": "Apache-2.0",
  "author": "Simarpreet Singh (https://x.com/simarpreet_019)",
  "homepage": "https://github.com/simarpreetsingh-019/questpass-booth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simarpreetsingh-019/questpass-booth.git"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/core/index.d.ts",
      "default": "./dist/questpass-booth.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/server.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "node scripts/serve.mjs",
    "setup": "node scripts/serve.mjs --setup",
    "sync-engine": "sh scripts/sync-engine.sh"
  },
  "dependencies": {
    "mp4-muxer": "5.1.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@fontsource/asap-condensed": "^5.1.1",
    "@fontsource/bebas-neue": "5.1.1",
    "@fontsource/caveat": "5.1.1",
    "@fontsource/cinzel": "5.1.1",
    "@fontsource/ibm-plex-mono": "5.1.1",
    "@fontsource/inter": "5.1.1",
    "@fontsource/permanent-marker": "5.1.1",
    "@fontsource/playfair-display": "5.1.1",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/node": "20.14.11",
    "@types/qrcode": "1.5.5",
    "esbuild": "0.24.0",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  }
}
